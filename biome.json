{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": { "includes": ["src/**", "*.ts", "*.json", "!tsconfig.tsbuildinfo"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110, "lineEnding": "crlf" },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useButtonType": "warn",
        "noSvgWithoutTitle": "warn",
        "useSemanticElements": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "noAutofocus": "warn"
      },
      "correctness": { "useExhaustiveDependencies": "warn" }
    }
  }
}
