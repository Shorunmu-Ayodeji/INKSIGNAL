{
  "name": "inksignal",
  "private": true,
  "version": "0.1.0",
  "description": "INKSIGNAL by 9thstreet — Your wallet. Your signal. Encrypted wallet-to-wallet messaging on Ink, powered by XMTP.",
  "author": "9thstreet",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "test": "vitest run"
  },
  "keywords": [
    "inksignal",
    "ink",
    "xmtp",
    "wagmi",
    "viem",
    "messaging"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "@xmtp/browser-sdk": "^7.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.10",
    "wagmi": "^3.7.9"
  }
}
